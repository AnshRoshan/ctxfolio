{
  "name": "ctxfolio",
  "version": "3.8.0",
  "description": "Source-backed project memory for coding agents: portable context wikis, governed capture, budgeted routing, read-only MCP and a zero-dependency CLI.",
  "license": "MIT",
  "type": "module",
  "main": "scripts/ctx.mjs",
  "bin": {
    "ctx": "scripts/ctx.mjs",
    "ctxfolio": "scripts/ctx.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/",
    "references/",
    "scripts/"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "test:lint": "node tests/run.mjs lint",
    "check": "node tests/run.mjs",
    "selftest": "node tests/run.mjs",
    "check:versions": "node tests/check-versions.mjs",
    "check:baseline": "node tests/check-baseline.mjs",
    "check:truth": "node tests/check-truth.mjs",
    "test:scale": "node tests/features22-29.mjs",
    "eval:routing": "node context/ctx.mjs eval --json"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "keywords": [
    "ai", "agent", "context", "llm", "wiki", "claude-code", "codex", "cursor", "copilot", "agents-md", "mcp", "documentation", "knowledge-base", "context-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AnshRoshan/ctxfolio.git"
  },
  "homepage": "https://anshroshan.github.io/ctxfolio/",
  "bugs": {
    "url": "https://github.com/AnshRoshan/ctxfolio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
